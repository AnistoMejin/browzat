{
  "manifest_version": 2,
  "name": "browzat",
  "version": "0.0.0",
  "description": "browzat: lets the AI agent on this computer use this browser, with your own logged-in profile.",
  "permissions": ["tabs", "scripting", "storage", "alarms", "cookies", "contextualIdentities", "<all_urls>"],
  "background": { "scripts": ["page.js", "core.js"], "persistent": true },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "browser_action": {
    "default_title": "browzat",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-mcp-bridge@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
