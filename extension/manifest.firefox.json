{
  "manifest_version": 2,
  "name": "Browser MCP Bridge",
  "version": "0.0.0",
  "description": "Lets the local Browser MCP server on this computer drive this browser, using your own logged-in profile.",
  "permissions": ["tabs", "scripting", "storage", "alarms", "cookies", "contextualIdentities", "<all_urls>"],
  "background": { "scripts": ["page.js", "core.js"], "persistent": true },
  "browser_action": { "default_title": "Browser MCP", "default_popup": "popup.html" },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-mcp-bridge@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
