{
  "name": "browzat",
  "version": "0.10.0",
  "description": "Local-first Browser MCP server and extension for AI agents to automate logged-in Chrome, Edge and Firefox profiles.",
  "keywords": [
    "browser-mcp",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "ai-browser-automation",
    "browser-automation",
    "browser-control",
    "browser-extension",
    "chrome-extension",
    "edge-extension",
    "firefox-extension",
    "chrome",
    "edge",
    "firefox",
    "claude-code",
    "claude-desktop",
    "web-automation",
    "local-first",
    "devtools"
  ],
  "license": "MIT",
  "author": "Anisto Mejin",
  "homepage": "https://github.com/AnistoMejin/browzat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnistoMejin/browzat.git"
  },
  "bugs": {
    "url": "https://github.com/AnistoMejin/browzat/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "browzat": "bin/browzat.js"
  },
  "files": [
    "bin/",
    "server/",
    "extension/",
    "assets/",
    "docs/distribution.md",
    "docs/privacy-policy.md",
    "install.ps1",
    "install.sh",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node extension/build.js",
    "check": "node test/check.js",
    "test": "node test/check.js",
    "start": "node server/cli.js start",
    "status": "node server/cli.js status",
    "pair": "node server/cli.js pair",
    "reload": "node server/cli.js reload all",
    "stop": "node server/cli.js stop",
    "release": "node scripts/release.js",
    "prepack": "npm run check"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
